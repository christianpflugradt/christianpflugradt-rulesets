{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Keep the published Please Behave governor current after successful CI.",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.please-version$/"],
      "matchStrings": ["^(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*$"],
      "depNameTemplate": "please-behave/cli",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["please-behave/cli"],
      "matchDatasources": ["github-releases"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false,
      "ignoreUnstable": true,
      "minimumReleaseAge": "0 days",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    }
  ]
}
